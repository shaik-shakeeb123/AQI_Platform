# ─────────────────────────────────────────────────────────────
# AQI Intelligence Platform — Environment Variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────

# Database connection string
DATABASE_URL=postgresql://postgres:your_password@localhost:5433/aqi_platform

# OpenAQ API (https://openaq.org)
OPENAQ_API_KEY=your_openaq_api_key_here
OPENAQ_BASE_URL=https://api.openaq.org/v3

# Open-Meteo API (https://open-meteo.com)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# OSRM routing (leave empty to use public router.project-osrm.org)
OSRM_BASE_URL=

# Application settings
APP_NAME=AQI Intelligence Platform
DEBUG=False
LOG_LEVEL=INFO

# JWT Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_chars

# Google OAuth 2.0 (required for Sign-In)
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# CORS — comma-separated origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Automated Ingestion Settings
INGESTION_INTERVAL_SECONDS=1800
SCHEDULED_TARGET_RECORDS=20
SCHEDULED_BATCH_SIZE=5
LOCK_FILE_AGE_THRESHOLD_SECS=3600
